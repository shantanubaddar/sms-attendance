# ---------------------------------------------------------------------------
# Online Attendance Management System — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL) --------------------------------------------------
# Recommended: free Postgres from Neon (https://neon.tech) — works for both
# local development AND Vercel production.
# In your Neon project: Dashboard → Connect → choose "Pooled" → copy the string.
# It looks like:
#   postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=""

# Or a local PostgreSQL server instead, e.g.:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sms"

# --- Auth -------------------------------------------------------------------
# Secret used to sign session JWTs. Generate a strong one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep the SAME value on Vercel — changing it later logs everyone out.
SESSION_SECRET=""
